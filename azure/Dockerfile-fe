# Multi-stage build for production
# This Dockerfile is optimized for production purposes, focusing on fast builds.
# It uses a multi-stage build to separate the build environment from the production runtime, ensuring a clean and efficient final image.
# #     chown -R nextjs:nodejs /var/log/nginx
FROM node:16-bullseye AS builder

# Install necessary packages for building
# RUN apk add --no-cache git python3 make g++ && npm install -g npm@8.19.4

# Set Node.js memory limit and production optimizations
ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV GENERATE_SOURCEMAP=false
ENV CI=true
ENV NODE_ENV=production
# ENV DISABLE_ESLINT_PLUGIN=true # Removed to enable ESLint plugin
ENV SKIP_PREFLIGHT_CHECK=true
ENV INLINE_RUNTIME_CHUNK=false

# Get the current Git commit hash and set it as a build argument
RUN apt-get update && apt-get install -y vim iputils-ping telnet
ARG COMMIT_HASH=unknown
LABEL commit_hash=$COMMIT_HASH
LABEL application="adherelive-frontend"
LABEL owner="AdhereLive Pvt Ltd"

# Stage 1: Create working directory & install npm packages
RUN mkdir -p /code
RUN mkdir -p /code/public
WORKDIR /code
COPY package.json ./
COPY package-lock.json ./

# Install dependencies without peer dependency conflicts
RUN npm install && npm cache clean --force --loglevel=error

# Copy source code
COPY . .
# Build application with production optimizations
RUN GENERATE_SOURCEMAP=false npm run build
RUN npm cache clean --force

# Stage 2: Production runtime with optimized nginx
FROM nginx
# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Copy built application from builder stage
COPY --from=builder /code/build/ /usr/share/nginx/html

# Add comprehensive health check for production monitoring
# HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
#     CMD wget --no-verbose --tries=1 --spider --timeout=5 http://localhost/ || exit 1
HEALTHCHECK NONE

# Add production security labels
LABEL environment="production"
LABEL security.scan="enabled"
LABEL security.non-root="true"
LABEL version="prod"
LABEL node.version="16-bullseye"
LABEL react.version="16.14.0"

EXPOSE 80

# Use nginx with proper configuration for production
CMD ["nginx", "-g", "daemon off;"]
