# terraform.tfvars.example
#
# Copy this file to 'terraform.tfvars' and fill in the required values.
# Do NOT commit terraform.tfvars to your version control.

# --- General ---
# The Azure region where resources will be deployed.
# location = "East US"

# The name for the resource group.
# resource_group_name = "adherelive-rg-prod"

# The deployment environment.
# environment = "prod"


# --- Naming (must be globally unique) ---
# A unique name for the Azure Key Vault.
# key_vault_name = "adherelive-kv-unique-suffix"

# A unique name for the Azure Container Registry.
# acr_name = "adhereliveacruniquesuffix"


# --- Database ---
# The administrator username for the MySQL Flexible Server.
mysql_admin_username = "adherelive"

# The administrator password for the MySQL Flexible Server.
# IMPORTANT: Use a strong, generated password.
mysql_admin_password = "YOUR_STRONG_MYSQL_PASSWORD"
